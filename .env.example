# Bu dosyayı kopyala:  cp .env.example .env   ve değerleri doldur.
# .env gizlidir (gitignore'lu); buradaki .env.example şablon olarak repoda durur.

PORT=3000

# ── Kimlik ──
BOT_USERNAME=Drakkar Archive
# Avatar: kalıcı olması için görseli webhook'a yükle; ya da kalıcı bir https URL koy.
BOT_AVATAR_URL=

# ── Varsayılan webhook (type eşleşmezse buraya düşer) ──
DISCORD_WEBHOOK_URL=
FORUM_CHANNEL_ID=

# ── Tür bazlı kanallar (kullandıklarını doldur) ──
# *_CHANNEL_ID forum kanalı için (post başlığı doğrudan gönderilsin diye); webhook tek başına yeter.
MOVIE_WEBHOOK_URL=
MOVIE_CHANNEL_ID=
SERIES_WEBHOOK_URL=
SERIES_CHANNEL_ID=
ANIME_WEBHOOK_URL=
ANIME_CHANNEL_ID=
ADULT_WEBHOOK_URL=
ADULT_CHANNEL_ID=

# ── JPV video API'sinden otomatik çekme ──
# Dolunca: ilk turda son JPV_SEED_COUNT video + sonra her JPV_POLL_MIN dk'da yeniler.
JPV_EMAIL=
JPV_PASSWORD=
JPV_API_BASE=https://japierdolevid.com/api/v1
JPV_POLL_MIN=5
JPV_SEED_COUNT=10

# ── Güvenlik (boşsa kapalı) ──
CALLBACK_SECRET=
